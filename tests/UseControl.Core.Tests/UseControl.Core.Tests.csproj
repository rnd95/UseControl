<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Test method names describe behaviour with underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UseControl.Core\UseControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PowerShell version's config files, to test that they import. -->
    <None Include="..\..\legacy\powershell\config.sample.json" Link="TestData\legacy.config.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
