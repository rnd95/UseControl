<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- LibraryImport (Windows API calls) generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Version>0.1.0</Version>
    <Product>UseControl</Product>
    <Authors>Rate Software</Authors>
    <Company>Rate Software</Company>
    <Copyright>Copyright © 2026 Rate Software</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
