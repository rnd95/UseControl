<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that reads or changes Windows: registry hives, restriction policies, NTFS, accounts, scans, audit. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UseControl.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UseControl.Core\UseControl.Core.csproj" />
    <ProjectReference Include="..\UseControl.Localization\UseControl.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UseControl.Windows.Tests" />
  </ItemGroup>

</Project>
