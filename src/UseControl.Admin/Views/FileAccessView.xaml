<UserControl x:Class="UseControl.Admin.Views.FileAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
             xmlns:pages="clr-namespace:UseControl.Admin.ViewModels.Pages;assembly=UseControl.Admin.ViewModels">
  <StackPanel>
    <TextBlock Text="{l:Tr Ui.Access.Intro}" Style="{StaticResource Help}" Margin="0,0,0,12" />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <!-- 1. What -->
        <TextBlock Text="{l:Tr Ui.Access.Path}" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Access.File}" Command="{Binding PickFileCommand}" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Access.Folder}" Command="{Binding PickFolderCommand}" Margin="8,0,0,0" />
          <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- 2. Which access -->
        <TextBlock Text="{l:Tr Ui.Access.Preset}" Style="{StaticResource SectionTitle}" />
        <ComboBox ItemsSource="{x:Static pages:FileAccessPageViewModel.Presets}" SelectedItem="{Binding Preset}" DisplayMemberPath="Text"
                  Width="420" HorizontalAlignment="Left" Margin="0,0,0,14" />

        <!-- 3. For whom -->
        <TextBlock Text="{l:Tr Ui.Access.ForAccounts}" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,0,14">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,4,18,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{l:Tr Ui.Access.AddRule}" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Access.Header}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{l:Tr Ui.Block.Empty}" Style="{StaticResource Help}" Margin="0,0,0,4"
                   Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVisibility}}" />
        <DataGrid ItemsSource="{Binding Rules}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Tr Ui.Column.Path}" Binding="{Binding Path}" Width="3*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Rights}" Binding="{Binding Rights}" Width="3*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Users}" Binding="{Binding Users}" Width="2*" />
            <DataGridTemplateColumn Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="&#xE74D;" Style="{StaticResource RowButton}" ToolTip="{l:Tr Ui.Remove}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{l:Tr Ui.Access.Help}" Style="{StaticResource Help}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
