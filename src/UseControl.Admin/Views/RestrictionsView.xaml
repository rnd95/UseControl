<!-- Windows restrictions of a profile: every switch is saved and applied when clicked. -->
<UserControl x:Class="UseControl.Admin.Views.RestrictionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <Border Style="{StaticResource Card}" Padding="16,12,16,4">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,4">
          <TextBlock Text="{l:Tr Ui.Restrictions.ToolsHeader}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Restrictions.ToolsHelp}" />
        </StackPanel>
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.CommandPrompt}" IsChecked="{Binding DisableCommandPrompt}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.RegistryEditor}" IsChecked="{Binding DisableRegistryEditor}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.TaskManager}" IsChecked="{Binding DisableTaskManager}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.ControlPanel}" IsChecked="{Binding DisableControlPanel}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.RunDialog}" IsChecked="{Binding DisableRunDialog}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.Autorun}" IsChecked="{Binding DisableAutorun}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Restrictions.PasswordChange}" IsChecked="{Binding DisablePasswordChange}" BorderThickness="0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="16,12,16,4">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,4">
          <TextBlock Text="{l:Tr Ui.Settings.AutoHeader}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Restrictions.AutoHelp}" />
        </StackPanel>
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.SystemDriveRoot}" IsChecked="{Binding SystemDriveRoot}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.WritableDriveRoots}" IsChecked="{Binding WritableDriveRoots}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.WritableProgramFolders}" IsChecked="{Binding WritableProgramFolders}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.OtherDriveLetters}" IsChecked="{Binding OtherDriveLetters}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.SystemWritableFolders}" IsChecked="{Binding SystemWritableFolders}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Auto.RecycleBins}" IsChecked="{Binding RecycleBins}" BorderThickness="0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
