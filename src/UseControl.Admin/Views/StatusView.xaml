<!-- Overview: is protection on, and how every restricted account is doing. -->
<UserControl x:Class="UseControl.Admin.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <!-- A new version is out -->
    <Border DataContext="{Binding Update}" Background="{DynamicResource AccentLight}" CornerRadius="{StaticResource Radius}" Padding="16,10" Margin="0,0,0,12"
            Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{l:Tr Ui.Update.WhatsNew}" Style="{StaticResource LinkButton}" Command="{Binding OpenPageCommand}" Margin="0,0,16,0" />
          <Button Content="{l:Tr Ui.Update.Install}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Margin="0"
                  Visibility="{Binding CanUpdateNow, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentText}" />
        <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="26" Margin="0,0,16,0" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource OkLight}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource DangerLight}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding IsEnabled, Converter={StaticResource OkBrush}, ConverterParameter=Danger}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Margin="0,0,8,0" ToolTip="{l:Tr Ui.Refresh}" Command="{Binding RefreshCommand}" />
          <Button Content="{l:Tr Ui.Status.ApplyNow}" Command="{Binding ApplyCommand}"
                  Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="{l:Tr Ui.Status.SuspendAll}" Style="{StaticResource DangerButton}" Command="{Binding SuspendCommand}" Margin="0"
                  Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="{l:Tr Ui.Status.Resume}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0"
                  Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Problems of the last apply -->
    <ItemsControl ItemsSource="{Binding Problems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource DangerLight}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                  Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{l:Tr Ui.Status.AccountsHeader}" Style="{StaticResource SectionTitle}" Margin="2,4,0,10" />
    <Border Style="{StaticResource Card}" Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroToVisibility}}">
      <TextBlock Text="{l:Tr Ui.Status.NoAccounts}" Style="{StaticResource Help}" Margin="0" />
    </Border>

    <!-- One card per restricted account -->
    <ItemsControl ItemsSource="{Binding Accounts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,12,12">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Avatar}" Margin="0,0,12,0">
                  <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentText}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding User}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12">
                    <Run Text="{l:Tr Ui.Preset.Label}" />
                    <Run Text="{Binding Profile, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </Grid>
              <!-- Restrictions -->
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Width="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="{Binding Restrictions}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Text}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RestrictionsWarning}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>
              <!-- Games -->
              <DockPanel Visibility="{Binding Games, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Width="24" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{Binding GamesAllowed, Converter={StaticResource OkBrush}}" />
                <StackPanel>
                  <TextBlock Text="{Binding Games}" TextWrapping="Wrap" Foreground="{Binding GamesAllowed, Converter={StaticResource OkBrush}}" />
                  <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0">
                    <Run Text="{Binding Played, Mode=OneWay}" />
                  </TextBlock>
                  <Border Style="{StaticResource Chip}" Background="{DynamicResource OkLight}" HorizontalAlignment="Left" Margin="0,6,0,0"
                          Visibility="{Binding Playing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Tr Ui.Games.PlayingNow}" FontSize="12" Foreground="{DynamicResource Ok}" />
                  </Border>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
