<!-- A list of blocked programs, names and folders, with its buttons. Used by the Games and Programs pages. -->
<UserControl x:Class="UseControl.Admin.Views.BlockListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <WrapPanel Margin="0,0,0,10">
      <Button Content="{Binding AddProgramText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddProgramCommand}" Margin="0,0,8,6" />
      <Button Content="{Binding AddFolderText}" Command="{Binding AddFolderCommand}" Margin="0,0,24,6" />
      <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,6" ToolTip="game.exe" />
      <Button Content="{l:Tr Ui.Block.AddName}" Command="{Binding AddNameCommand}" Margin="0,0,0,6" />
    </WrapPanel>

    <TextBlock Text="{l:Tr Ui.Block.Empty}" Style="{StaticResource Help}" Margin="0,0,0,4"
               Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibility}}" />

    <DataGrid ItemsSource="{Binding Rows}" MaxHeight="420">
      <DataGrid.Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.Style>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Ui.Column.Name}" Binding="{Binding Text}" Width="3*" />
        <DataGridTextColumn Header="{l:Tr Ui.Column.Kind}" Binding="{Binding KindText}" Width="1.5*" />
        <DataGridTextColumn Header="{l:Tr Ui.Column.Category}" Binding="{Binding CategoryText}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn Header="{l:Tr Ui.Column.Note}" Binding="{Binding Detail}" Width="*" />
        <DataGridTemplateColumn Width="44">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="&#xE74D;" Style="{StaticResource RowButton}" ToolTip="{l:Tr Ui.Remove}"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
