<UserControl x:Class="UseControl.Admin.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
             xmlns:views="clr-namespace:UseControl.Admin.Views"
             xmlns:pages="clr-namespace:UseControl.Admin.ViewModels.Pages;assembly=UseControl.Admin.ViewModels">
  <StackPanel>
    <!-- Now: who may play, with buttons per account -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Games.NowHeader}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{l:Tr Ui.Preset.NoAccounts}" Style="{StaticResource Help}" Margin="0,0,0,8"
                   Visibility="{Binding Now.Count, Converter={StaticResource ZeroToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Now}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ok}" Visibility="{Binding Playing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding User}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{Binding Allowed, Converter={StaticResource StateBrush}, ConverterParameter=Text}" />
                    <TextBlock Text="{Binding Played}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{l:Tr Ui.Games.Allow}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DataContext.AllowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="{l:Tr Ui.Games.Lock}" Margin="0"
                            Command="{Binding DataContext.LockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- How much "Allow" gives -->
        <WrapPanel Margin="0,12,0,0">
          <TextBlock Text="{l:Tr Ui.Games.AllowFor}" Style="{StaticResource Label}" />
          <ComboBox ItemsSource="{x:Static pages:GamesPageViewModel.HourChoices}" SelectedItem="{Binding Hours}" Width="80" Margin="0,0,8,0">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Hours}}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{l:Tr Ui.Games.Hours}" Style="{StaticResource Label}" Margin="0,0,20,0" />
          <RadioButton Content="{l:Tr Ui.Games.CountPlay}" IsChecked="{Binding CountPlayOnly}" GroupName="count" />
          <RadioButton Content="{l:Tr Ui.Games.CountClock}" IsChecked="{Binding CountPlayOnly, Converter={StaticResource InverseBool}}" GroupName="count" />
        </WrapPanel>
        <TextBlock Text="{l:Tr Ui.Games.AllowHelp}" Style="{StaticResource Help}" />
      </StackPanel>
    </Border>

    <!-- When games are allowed -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Games.WhenHeader}" Style="{StaticResource SectionTitle}" />
        <RadioButton Content="{l:Tr Ui.Games.ModeManual}" IsChecked="{Binding IsManual}" GroupName="mode" Margin="0,2" />
        <RadioButton Content="{l:Tr Ui.Games.ModeSchedule}" IsChecked="{Binding IsSchedule}" GroupName="mode" Margin="0,2" />

        <StackPanel Margin="26,8,0,0" Visibility="{Binding IsSchedule, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:Tr Ui.Games.NoWindows}" Style="{StaticResource Help}" Margin="0,0,0,8"
                     Visibility="{Binding Schedule.Count, Converter={StaticResource ZeroToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Schedule}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Subtle}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE74D;" Style="{StaticResource RowButton}" ToolTip="{l:Tr Ui.Remove}"
                            Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- New time window -->
          <TextBlock Text="{l:Tr Ui.Games.AddWindowHeader}" Style="{StaticResource Label}" Margin="0,10,0,6" />
          <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Content="{Binding Text}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayToggle}" Margin="0,0,6,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel>
            <TextBlock Text="{l:Tr Ui.Games.From}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding From}" DisplayMemberPath="Text" Width="96" Margin="0,0,12,6" />
            <TextBlock Text="{l:Tr Ui.Games.To}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding To}" DisplayMemberPath="Text" Width="96" Margin="0,0,12,6" />
            <TextBlock Text="{l:Tr Ui.Games.Limit}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Limits}" SelectedItem="{Binding Limit}" DisplayMemberPath="Text" Width="140" Margin="0,0,12,6" />
            <Button Content="{l:Tr Ui.Games.AddWindow}" Style="{StaticResource PrimaryButton}" Command="{Binding AddWindowCommand}" Margin="0,0,0,6" />
          </WrapPanel>
          <TextBlock Text="{l:Tr Ui.Games.ScheduleHelp}" Style="{StaticResource Help}" />
        </StackPanel>

        <CheckBox Content="{l:Tr Ui.Games.CloseWhenOver}" IsChecked="{Binding CloseGamesWhenOver}" Margin="0,14,0,0" />
        <TextBlock Text="{l:Tr Ui.Games.Help}" Style="{StaticResource Help}" />
      </StackPanel>
    </Border>

    <!-- Blocked games -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Games.ListHeader}" Style="{StaticResource SectionTitle}" />
        <views:BlockListView DataContext="{Binding List}" />
      </StackPanel>
    </Border>

    <!-- Find installed games -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Games.FindHeader}" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="{l:Tr Ui.Games.Find}" Command="{Binding FindCommand}" />
          <Button Content="{l:Tr Ui.Games.BlockSelected}" Style="{StaticResource PrimaryButton}" Command="{Binding BlockSelectedCommand}"
                  Visibility="{Binding Searched, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Found}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
