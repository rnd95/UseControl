<UserControl x:Class="UseControl.Admin.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Audit.Run}" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Margin="0" />
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Checks}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="{Binding Status, Converter={StaticResource StateBrush}}">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                           Foreground="{Binding Status, Converter={StaticResource StateBrush}, ConverterParameter=Text}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
