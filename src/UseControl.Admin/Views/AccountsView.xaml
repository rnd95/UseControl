<UserControl x:Class="UseControl.Admin.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}">
          <TextBlock Text="{l:Tr Ui.Accounts.Header}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Accounts.Help}" />
        </StackPanel>

        <TextBlock Text="{l:Tr Ui.Accounts.Empty}" Style="{StaticResource Help}" Margin="0"
                   Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroToVisibility}}" />

        <!-- One row per account: name, state, its profile, and the one button that applies to it. -->
        <ItemsControl ItemsSource="{Binding Accounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}" Padding="0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Avatar}" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentText}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,1,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRestricted}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Exists}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <!-- For a restricted account changing the profile moves it; otherwise it is the profile it will get. -->
                  <ComboBox Grid.Column="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" DisplayMemberPath="Text" Width="200"
                            VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{l:Tr Ui.Preset.Label}" />
                  <Grid Grid.Column="3" VerticalAlignment="Center">
                    <Button Content="{l:Tr Ui.Accounts.Add}" Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="140"
                            Command="{Binding DataContext.RestrictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Button Content="{l:Tr Ui.Accounts.Remove}" Margin="0" MinWidth="140"
                            Command="{Binding DataContext.UnrestrictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- For the whole PC, whatever the profiles say. -->
    <Border Style="{StaticResource Card}" Padding="16,12,16,4">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,4">
          <TextBlock Text="{l:Tr Ui.Accounts.WholePc}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Restrictions.InstallHelp}" />
        </StackPanel>
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Settings.Store}" IsChecked="{Binding BlockStoreInstalls}" BorderThickness="0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
