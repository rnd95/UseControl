<UserControl x:Class="UseControl.Admin.Views.BrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
             xmlns:pages="clr-namespace:UseControl.Admin.ViewModels.Pages;assembly=UseControl.Admin.ViewModels">
  <StackPanel>
    <!-- Which browser: the settings below are its own. -->
    <ListBox Style="{StaticResource Segmented}" ItemsSource="{x:Static pages:BrowsersPageViewModel.Browsers}" SelectedItem="{Binding Browser}"
             HorizontalAlignment="Left" Margin="0,0,0,12" />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,4">
          <TextBlock Text="{l:Tr Ui.Browsers.Extensions}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Browsers.ExtensionsHelp}" />
        </StackPanel>
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Browsers.BlockExtensions}" IsChecked="{Binding BlockExtensions}" Margin="0,0,0,10" />
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Add}" Style="{StaticResource PrimaryButton}" Command="{Binding AddExtensionCommand}" Margin="8,0,0,0" />
          <TextBox Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintBox}" Tag="{l:Tr Ui.Browsers.ExtensionId}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Extensions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}" Padding="0,4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="&#xE74D;" Style="{StaticResource DangerIconButton}" ToolTip="{l:Tr Ui.Remove}"
                          Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding}" FontFamily="Consolas" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="16,8,16,4" Visibility="{Binding IsFirefox, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Browsers.DisableDoh}" IsChecked="{Binding DisableDnsOverHttps}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Browsers.DisablePrivate}" IsChecked="{Binding DisablePrivateBrowsing}" BorderThickness="0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}">
          <TextBlock Text="{l:Tr Ui.Browsers.Policies}" Style="{StaticResource CardTitle}" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Browsers.Help}" />
        </StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding PolicyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintBox}" Tag="{l:Tr Ui.Browsers.PolicyName}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding PolicyValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintBox}" Tag="{l:Tr Ui.Column.Value}" />
          <Button Grid.Column="2" Content="{l:Tr Ui.Browsers.Set}" Style="{StaticResource PrimaryButton}" Command="{Binding SetPolicyCommand}" Margin="8,0,0,0" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Policies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}" Padding="0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE70F;" Style="{StaticResource IconButton}" ToolTip="{l:Tr Ui.Edit}"
                            Command="{Binding DataContext.EditPolicyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="&#xE74D;" Style="{StaticResource DangerIconButton}" ToolTip="{l:Tr Ui.Remove}"
                            Command="{Binding DataContext.RemovePolicyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
