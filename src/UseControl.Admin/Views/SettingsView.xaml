<UserControl x:Class="UseControl.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Settings.Language}" Style="{StaticResource SectionTitle}" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Text" Width="220" HorizontalAlignment="Left" />
        <TextBlock Text="{l:Tr Ui.Settings.LanguageHelp}" Style="{StaticResource Help}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Settings.BackupHeader}" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal">
          <Button Content="{l:Tr Ui.Settings.Export}" Command="{Binding ExportCommand}" />
          <Button Content="{l:Tr Ui.Settings.Import}" Command="{Binding ImportCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Settings.AboutHeader}" Style="{StaticResource SectionTitle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Ui.Settings.Version}" Style="{StaticResource Label}" Margin="0,3" />
          <TextBlock Grid.Column="1" Text="{Binding PanelVersion}" Margin="0,3" />
          <TextBlock Grid.Row="1" Text="{l:Tr Ui.Status.Service}" Style="{StaticResource Label}" Margin="0,3" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceVersion}" Margin="0,3" />
          <TextBlock Grid.Row="2" Text="{l:Tr Ui.Settings.DataFolder}" Style="{StaticResource Label}" Margin="0,3" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataDirectory}" Margin="0,3" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
