<UserControl x:Class="UseControl.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
          <TextBlock Text="{l:Tr Ui.Settings.Language}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Settings.LanguageHelp}" />
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Text" Width="220"
                  HorizontalAlignment="Left" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" Text="{l:Tr Ui.Settings.ThemeHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Text" Width="220" HorizontalAlignment="Left" />
      </Grid>
    </Border>

    <!-- Updates of UseControl itself -->
    <Border Style="{StaticResource Card}" DataContext="{Binding Update}">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{l:Tr Ui.Update.Check}" Command="{Binding CheckCommand}" />
            <Button Content="{l:Tr Ui.Update.Install}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Margin="0"
                    Visibility="{Binding CanUpdateNow, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="{l:Tr Ui.Update.Header}" Style="{StaticResource CardTitle}" />
            <ToggleButton Style="{StaticResource HelpTip}" Tag="{l:Tr Ui.Update.Help}" />
          </StackPanel>
        </DockPanel>
        <TextBlock TextWrapping="Wrap">
          <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold">
            <Run.Style>
              <Style TargetType="Run">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Available}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Run.Style>
          </Run>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
          <TextBlock Text="{Binding LastCheckText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
          <Button Content="{l:Tr Ui.Update.WhatsNew}" Style="{StaticResource LinkButton}" Command="{Binding OpenPageCommand}" FontSize="12"
                  Visibility="{Binding Available, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <TextBlock Text="{l:Tr Error.UpdateNeedsInstaller}" Style="{StaticResource Help}" Foreground="{DynamicResource Warning}" Margin="0,0,0,6"
                   Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Update.CheckDaily}" IsChecked="{Binding CheckDaily}" />
        <CheckBox Style="{StaticResource Switch}" Content="{l:Tr Ui.Update.Auto}" IsChecked="{Binding InstallAutomatically}" BorderThickness="0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Settings.BackupHeader}" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal">
          <Button Content="{l:Tr Ui.Settings.Export}" Command="{Binding ExportCommand}" />
          <Button Content="{l:Tr Ui.Settings.Import}" Command="{Binding ImportCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Source="/UseControl;component/Assets/uc.ico" Width="48" Height="48" VerticalAlignment="Top" Margin="0,2,16,0" />
        <StackPanel Grid.Column="1">
          <TextBlock FontSize="16" FontWeight="SemiBold">
            <Run Text="UseControl" />
            <Run Text="{Binding PanelVersion, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal" />
          </TextBlock>
          <TextBlock Text="{Binding Copyright}" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Ui.Status.Service}" Style="{StaticResource Label}" Margin="0,3" />
            <TextBlock Grid.Column="1" Text="{Binding ServiceVersion}" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="{l:Tr Ui.Settings.DataFolder}" Style="{StaticResource Label}" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataDirectory}" Margin="0,3" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
