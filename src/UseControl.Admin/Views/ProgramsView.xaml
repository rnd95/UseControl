<UserControl x:Class="UseControl.Admin.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
             x:Name="Root">
  <UserControl.Resources>
    <!-- The remove button of a row; Tag names the command of the page. -->
    <DataTemplate x:Key="RemoveCell">
      <Button Content="&#xE74D;" Style="{StaticResource RowButton}" ToolTip="{l:Tr Ui.Remove}"
              Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{l:Tr Ui.Programs.Category}" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Text" Width="180" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Programs.AddFolder}" Style="{StaticResource PrimaryButton}" Command="{Binding BlockFolderCommand}" Margin="0" />
          <TextBlock Text="{l:Tr Ui.Programs.BlockedFolders}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding BlockedFolders}" Tag="{Binding RemoveBlockedFolderCommand}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Tr Ui.Column.Path}" Binding="{Binding Text}" Width="*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Category}" Binding="{Binding Category}" Width="140" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Note}" Binding="{Binding Note}" Width="180" />
            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource RemoveCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Programs.AddAllowed}" Command="{Binding AllowFolderCommand}" Margin="0" />
          <TextBlock Text="{l:Tr Ui.Programs.AllowedFolders}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding AllowedFolders}" Tag="{Binding RemoveAllowedFolderCommand}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Tr Ui.Column.Path}" Binding="{Binding Text}" Width="*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Note}" Binding="{Binding Note}" Width="180" />
            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource RemoveCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Programs.BlockedNames}" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Programs.AddName}" Style="{StaticResource PrimaryButton}" Command="{Binding BlockNameCommand}" Margin="8,0,0,0" />
          <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="game.exe" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding BlockedNames}" Tag="{Binding RemoveBlockedNameCommand}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Tr Ui.Column.Name}" Binding="{Binding Text}" Width="*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Category}" Binding="{Binding Category}" Width="140" />
            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource RemoveCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="{l:Tr Ui.Programs.AddFile}" Style="{StaticResource PrimaryButton}" Command="{Binding BlockFileCommand}" Margin="0" />
          <TextBlock Text="{l:Tr Ui.Programs.BlockedFiles}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding BlockedFiles}" Tag="{Binding RemoveBlockedFileCommand}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Tr Ui.Column.Name}" Binding="{Binding Text}" Width="*" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Category}" Binding="{Binding Category}" Width="140" />
            <DataGridTextColumn Header="{l:Tr Ui.Column.Note}" Binding="{Binding Note}" Width="180" />
            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource RemoveCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <TextBlock Text="{l:Tr Ui.Programs.Help}" Style="{StaticResource Help}" />
  </StackPanel>
</UserControl>
