<UserControl x:Class="UseControl.Admin.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
             xmlns:views="clr-namespace:UseControl.Admin.Views">
  <StackPanel>
    <TextBlock Text="{l:Tr Ui.Programs.Help}" Style="{StaticResource Help}" Margin="0,0,0,12" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:Tr Ui.Programs.Header}" Style="{StaticResource SectionTitle}" />
        <views:BlockListView DataContext="{Binding List}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
