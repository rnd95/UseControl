<!-- Colours of the light theme. Dark.xaml has the same keys; styles refer to them with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentLight" Color="#DBEAFE" />
  <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="WindowBackground" Color="#F3F4F6" />
  <SolidColorBrush x:Key="NavBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlHover" Color="#F3F4F6" />
  <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderBackground" Color="#F9FAFB" />
  <SolidColorBrush x:Key="Subtle" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Border" Color="#E5E7EB" />
  <SolidColorBrush x:Key="BorderStrong" Color="#D1D5DB" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#C4C8CF" />
  <SolidColorBrush x:Key="Text" Color="#111827" />
  <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
  <SolidColorBrush x:Key="Ok" Color="#15803D" />
  <SolidColorBrush x:Key="OkLight" Color="#DCFCE7" />
  <SolidColorBrush x:Key="Warning" Color="#B45309" />
  <SolidColorBrush x:Key="WarningLight" Color="#FEF3C7" />
  <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
  <SolidColorBrush x:Key="DangerLight" Color="#FEE2E2" />
  <SolidColorBrush x:Key="DangerBorder" Color="#FCA5A5" />
  <SolidColorBrush x:Key="InfoLight" Color="#E0F2FE" />
</ResourceDictionary>
