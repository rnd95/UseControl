<Window x:Class="UseControl.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UseControl.Admin.Infrastructure"
        Title="{l:Tr Ui.App.Title}" Icon="Assets/uc.ico"
        Width="1100" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation: the PC as a whole, the chosen profile, this PC (groups are set up in MainWindow.xaml.cs). -->
    <Border Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,12">
          <Image Source="Assets/uc.ico" Width="28" Height="28" />
          <TextBlock Text="UseControl" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <ListBox x:Name="Nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource NavItem}" MaxHeight="10000"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name.Title}" Style="{StaticResource NavHeader}"
                             Visibility="{Binding Name.Title, Converter={StaticResource TextToVisibility}}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="28" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <!-- Top, outside the scrolling area: the page title and, on pages of a profile, the profile chooser. -->
      <Grid DockPanel.Dock="Top" Margin="28,18,34,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource PageTitle}" Margin="0" />
          <TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding PageSubtitle, Converter={StaticResource TextToVisibility}}" />
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,6,6,6" Margin="16,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding SelectedPage.UsesPreset, Converter={StaticResource BoolToVisibility}}"
                IsEnabled="{Binding Session.CanEdit}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource AccentText}" ToolTip="{l:Tr Ui.Preset.Label}" />
            <ComboBox ItemsSource="{Binding Session.PresetNames}" SelectedItem="{Binding Session.PresetName}" MinWidth="180" VerticalAlignment="Center"
                      ToolTip="{l:Tr Ui.Preset.Label}" />
            <Button Content="&#xE710;" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="{l:Tr Ui.Preset.New}" Command="{Binding NewPresetCommand}" />
            <Button Content="&#xE70F;" Style="{StaticResource IconButton}" ToolTip="{l:Tr Ui.Preset.Rename}" Command="{Binding RenamePresetCommand}" />
            <Button Content="&#xE74D;" Style="{StaticResource DangerIconButton}" ToolTip="{l:Tr Ui.Preset.Delete}" Command="{Binding DeletePresetCommand}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Bottom: busy / not connected -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="28,0,24,10">
        <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,10,0"
                     Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{l:Tr Ui.Busy}" Foreground="{DynamicResource TextMuted}"
                   Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{l:Tr Ui.NotConnected}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,10,0"
                   Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <Button Content="{l:Tr Ui.Retry}" Command="{Binding RetryCommand}"
                Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
      </StackPanel>

      <!-- Bottom, above it: the message bar (success and info messages hide after 10 seconds). -->
      <Border DockPanel.Dock="Bottom" Margin="28,6,34,8" Padding="14,10" CornerRadius="{StaticResource Radius}"
              BorderThickness="1" BorderBrush="{DynamicResource Border}"
              Background="{Binding Session.MessageKind, Converter={StaticResource StateBrush}}"
              Visibility="{Binding Session.Message, Converter={StaticResource TextToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" Width="26" Height="26"
                  Command="{Binding DismissMessageCommand}" ToolTip="{l:Tr Ui.Close}" />
          <TextBlock Text="{Binding Session.Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{Binding Session.MessageKind, Converter={StaticResource StateBrush}, ConverterParameter=Text}" />
        </DockPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,24,8">
        <ContentControl Content="{Binding SelectedPage}" IsEnabled="{Binding Session.CanEdit}" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
