<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the admin panel does, without any WPF: page view models, commands, texts. The WPF
    project only draws them, so the look can change freely without touching the behaviour.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UseControl.Admin.ViewModels</RootNamespace>
    <!-- Command methods return Task on purpose (RelayCommand); returning Task<bool> would change nothing for callers. -->
    <NoWarn>$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UseControl.Ipc\UseControl.Ipc.csproj" />
    <ProjectReference Include="..\UseControl.Localization\UseControl.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UseControl.Admin.Tests" />
  </ItemGroup>

</Project>